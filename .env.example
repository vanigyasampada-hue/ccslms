# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://vanijya_sampada:vanijya_sampada_dev_pw@localhost:5432/vanijya_sampada?schema=public"

# ── Redis ─────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT (RS256 — generate with scripts/generate-jwt-keys.sh) ──
JWT_PRIVATE_KEY_PATH="./keys/jwt_private.pem"
JWT_PUBLIC_KEY_PATH="./keys/jwt_public.pem"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ── Bcrypt ────────────────────────────────────────────────
BCRYPT_COST=12

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# ── Rate limiting ─────────────────────────────────────────
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ── MinIO (S3-compatible file storage) ───────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="vanijya_sampada_minio"
MINIO_SECRET_KEY="vanijya_sampada_minio_dev_pw"
MINIO_BUCKET="vanijya-sampada-files"

# ── Captcha ───────────────────────────────────────────────
CAPTCHA_PROVIDER="builtin" # default: self-hosted captcha, no key needed; or "recaptcha" / "hcaptcha"
CAPTCHA_SECRET_KEY=""

# ── Swikriti challan portal (see lib/payment-links.ts) ────
# The exact query-parameter contract isn't documented in the source
# specs available here — confirm against Swikriti's real integration
# guide before production use.
SWIKRITI_PORTAL_BASE_URL=""

# ── Payment gateway webhooks (routes/payment-webhook.routes.ts) ────
# Left unset by default -- webhooks are REJECTED (not silently trusted)
# when their corresponding secret is empty. Only set these once a real
# gateway account exists to receive a shared signing secret from.
UPI_WEBHOOK_SECRET=""
SWIKRITI_WEBHOOK_SECRET=""

# Official report letterhead: printed as "GOVERNMENT OF <GOVERNMENT_NAME>" on every PDF report.
GOVERNMENT_NAME=Karnataka

# ── One-Day Password (ODP) SMS delivery ──────────────────────────────────
# Staff login needs the ODP sent by SMS. In production an unset provider is
# REFUSED (login codes are never logged outside development).
# Generic HTTP adapter (apps/api/src/lib/sms.ts): placeholders {mobile}
# {message} {sender_id} {dlt_entity_id} {dlt_template_id} {api_key} are
# URL-encoded in URLs/form bodies and JSON-escaped in JSON bodies.
# TRAI DLT: SMS_MESSAGE_TEMPLATE must match your registered template EXACTLY.
SMS_PROVIDER=""            # "" = dev only (code logged); "http" = send via the gateway below
SMS_HTTP_METHOD="GET"
SMS_HTTP_URL=""
SMS_HTTP_BODY=""           # for POST gateways
SMS_HTTP_HEADERS=""        # JSON object, e.g. {"authkey":"{api_key}"}
SMS_HTTP_SUCCESS_PATTERN="" # regex the response must match (some gateways return 200 on rejection)
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_ENTITY_ID=""
SMS_DLT_TEMPLATE_ID=""
SMS_MOBILE_PREFIX="91"
SMS_MESSAGE_TEMPLATE=""    # default: "{code} is your Vanijya Sampada login code, valid for 24 hours. Do not share it with anyone. - Govt of Karnataka"
SMS_MERCHANT_TEMPLATE=""   # default: "Vanijya Sampada: log in with your mobile {mobile} and temporary password {password}. You must change it at first login. - Govt of Karnataka"
#
# Example -- NIC SMS gateway (GET), adapt to the credentials NIC issues:
#   SMS_PROVIDER="http"
#   SMS_HTTP_URL="https://smsgw.sms.gov.in/failsafe/MLink?username=<user>&pin={api_key}&message={message}&mnumber={mobile}&signature={sender_id}&dlt_entity_id={dlt_entity_id}&dlt_template_id={dlt_template_id}"
#   SMS_HTTP_SUCCESS_PATTERN="Message Accepted"
# Example -- JSON POST gateway (MSG91-style):
#   SMS_PROVIDER="http"
#   SMS_HTTP_METHOD="POST"
#   SMS_HTTP_URL="https://<gateway>/api/v5/flow"
#   SMS_HTTP_HEADERS='{"authkey":"{api_key}"}'
#   SMS_HTTP_BODY='{"template_id":"{dlt_template_id}","recipients":[{"mobiles":"{mobile}","message":"{message}"}]}'

# ── Production (docker-compose.prod.yml) ─────────────────────────────────
# Number of reverse proxies in front of the API. Leave EMPTY when the API is
# reached directly (local dev); the production compose sets 1 (nginx).
TRUST_PROXY=
# Public origin browsers use, e.g. https://vanijya.example.gov.in -- signed
# file links (photos, circulars) must name it; nginx proxies them to MinIO.
MINIO_PUBLIC_URL=
# Required by docker-compose.prod.yml (choose strong values; the dev
# defaults above must NOT be used in production).
POSTGRES_PASSWORD=
# Only for CAPTCHA_PROVIDER=recaptcha/hcaptcha: the provider's PUBLIC site
# key (secret in CAPTCHA_SECRET_KEY). The default built-in captcha needs none.
CAPTCHA_SITE_KEY=
# Build identifier shown in the footer and diagnostics (§5.7), e.g.:
#   APP_VERSION=$(git rev-parse --short HEAD) docker compose -f docker-compose.prod.yml up -d --build
APP_VERSION=
